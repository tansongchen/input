{
  "name": "input",
  "version": "1.0.0",
  "description": "谭淞宸的输入方案",
  "main": "index.js",
  "scripts": {
    "start": "vitepress dev --port 2024",
    "build-only": "vitepress build",
    "simulate": "bun run src/simulate.ts",
    "build": "bun run install-rime && bun run install-snow && bun run simulate && vitepress build",
    "preview": "vitepress preview",
    "install-rime": "wget https://github.com/rimeinn/fcitx5-rime.js/releases/download/0.3.1/fcitx5-rime.tgz -O fcitx5-rime.tgz && bun add ./fcitx5-rime.tgz",
    "install-snow": "mkdir -p public && wget https://github.com/rimeinn/rime-snow-pinyin/releases/download/v0.3.9/snow-pinyin-build.zip -O public/snow-pinyin-build.zip",
    "export": "press-export-pdf export .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "author": "Songchen Tan",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@css-render/vue3-ssr": "^0.15.14",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "markdown-it-mathjax3": "^4.3.2",
    "vite-plugin-static-copy": "^3.1.2",
    "vitepress": "1.6.4",
    "vitepress-export-pdf": "^1.0.0"
  },
  "dependencies": {
    "@datastructures-js/priority-queue": "^6.3.1",
    "@pinyin-pro/data": "^1.2.0",
    "@types/node": "^26.6.3",
    "@vicons/fa": "^0.13.0",
    "fcitx5-rime": "./fcitx5-rime.tgz",
    "lodash-es": "^4.17.21",
    "naive-ui": "^2.39.0",
    "pinyin-pro": "^3.26.0",
    "supermemo": "^2.0.17",
    "vooks": "^0.2.12",
    "vue": "^3.4.37"
  }
}
